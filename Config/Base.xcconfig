// Base.xcconfig
// Shared build settings for all targets (applied at project level).
//
// Personal values (team, bundle prefix, Strava credentials) belong in
// Config/Secrets.xcconfig, which is gitignored and included at the end of this
// file so it can override anything defined here.

// Apple Developer team used for automatic signing. Set it in Secrets.xcconfig
// (DEVELOPMENT_TEAM = ABCDE12345) or in Xcode › Signing & Capabilities.
DEVELOPMENT_TEAM =

// Reverse-DNS prefix for all bundle identifiers. Must be unique for your team.
// The app becomes $(BUNDLE_ID_PREFIX).foodtracker, the widget extension
// $(BUNDLE_ID_PREFIX).foodtracker.widgets.
BUNDLE_ID_PREFIX = com.lucasfeja

// App Group shared by the app and the widget extension (SwiftData store and
// settings). Used by both entitlements files and exposed via Info.plist.
APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).foodtracker

// Strava API credentials. Real values live in Secrets.xcconfig.
STRAVA_CLIENT_ID =
STRAVA_CLIENT_SECRET =

#include? "Secrets.xcconfig"
