// Secrets.example.xcconfig
// Copy this file to Config/Secrets.xcconfig (gitignored) and fill in your values:
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Never commit Secrets.xcconfig.

// Strava API application (https://www.strava.com/settings/api)
// Authorization Callback Domain in Strava must be: foodtracker
STRAVA_CLIENT_ID = 298532
STRAVA_CLIENT_SECRET = YOUR_STRAVA_CLIENT_SECRET

// Signing (optional here; can also be set in Xcode)
// DEVELOPMENT_TEAM = ABCDE12345
// BUNDLE_ID_PREFIX = com.yourname
